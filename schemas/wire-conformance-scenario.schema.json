{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NagareWorks/nnrp-conformance/schemas/wire-conformance-scenario.schema.json",
  "title": "NNRP Wire-level Conformance Scenario Manifest",
  "type": "object",
  "$defs": {
    "unsignedDecimalU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "cacheIdentity": {
      "type": "object",
      "required": ["cache_namespace", "cache_key_hi", "cache_key_lo"],
      "properties": {
        "cache_namespace": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cache_key_hi": {"$ref": "#/$defs/unsignedDecimalU64"},
        "cache_key_lo": {"$ref": "#/$defs/unsignedDecimalU64"}
      }
    },
    "transport": {
      "type": "string",
      "enum": ["tcp", "quic", "websocket", "ipc"]
    },
    "rejectionReason": {
      "type": "string",
      "enum": [
        "policy-disallowed",
        "local-unavailable",
        "peer-unsupported",
        "limit-exceeded",
        "route-unresolved",
        "security-unsatisfied",
        "probe-missing",
        "probe-failed"
      ]
    },
    "hostRouteSecurity": {
      "type": "object",
      "required": ["mode", "credential_owner"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["plain", "tls_server_auth", "mutual_tls", "wss", "browser_host"]
        },
        "credential_owner": {
          "type": "string",
          "enum": ["none", "suite", "target", "host"]
        }
      },
      "additionalProperties": false
    },
    "hostRoute": {
      "type": "object",
      "required": ["role", "platform", "application_endpoint", "routes"],
      "properties": {
        "role": {"type": "string", "enum": ["client", "server"]},
        "platform": {"type": "string", "enum": ["native", "browser"]},
        "application_endpoint": {"type": "string", "pattern": "^nnrps?://"},
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["transport", "provider_id", "locator", "security"],
            "properties": {
              "transport": {"$ref": "#/$defs/transport"},
              "provider_id": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1},
              "security": {"$ref": "#/$defs/hostRouteSecurity"},
              "injected_failures": {
                "type": "array",
                "description": "Suite fault controls, not rejection tokens. route_unresolved maps to route-unresolved; security_incompatible maps to security-unsatisfied; bind and terminal-listener failures are listener-state oracles.",
                "items": {
                  "type": "string",
                  "enum": [
                    "route_unresolved",
                    "security_incompatible",
                    "bind_failure",
                    "terminal_listener_failure"
                  ]
                },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {"properties": {"transport": {"const": "tcp"}}, "required": ["transport"]},
                "then": {
                  "properties": {
                    "security": {
                      "properties": {"mode": {"enum": ["plain", "tls_server_auth", "mutual_tls"]}}
                    }
                  }
                }
              },
              {
                "if": {"properties": {"transport": {"const": "quic"}}, "required": ["transport"]},
                "then": {
                  "properties": {
                    "security": {
                      "properties": {"mode": {"enum": ["tls_server_auth", "mutual_tls"]}}
                    }
                  }
                }
              },
              {
                "if": {"properties": {"transport": {"const": "ipc"}}, "required": ["transport"]},
                "then": {
                  "properties": {
                    "security": {"properties": {"mode": {"const": "plain"}}}
                  }
                }
              },
              {
                "if": {"properties": {"transport": {"const": "websocket"}}, "required": ["transport"]},
                "then": {
                  "properties": {
                    "security": {
                      "properties": {"mode": {"enum": ["plain", "wss", "browser_host"]}}
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hostRouteExpectation": {
      "type": "object",
      "properties": {
        "selected_count": {"type": "integer", "minimum": 0},
        "selected_transport": {"$ref": "#/$defs/transport"},
        "rejection_reasons": {
          "type": "array",
          "items": {"$ref": "#/$defs/rejectionReason"},
          "uniqueItems": true
        },
        "bound_transports": {
          "type": "array",
          "items": {"$ref": "#/$defs/transport"},
          "uniqueItems": true
        },
        "accepted_transports": {
          "type": "array",
          "items": {"$ref": "#/$defs/transport"},
          "uniqueItems": true
        },
        "atomic_rollback": {"type": "boolean"},
        "logical_set_closed": {"type": "boolean"},
        "terminal_failure": {"type": "string", "minLength": 1}
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "required": ["protocol_version", "manifest_name", "scenarios"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string",
      "const": "nnrp-1-preview4"
    },
    "manifest_name": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "status",
          "feature",
          "required_capabilities",
          "description",
          "steps",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": ["suite_as_client", "suite_as_server", "suite_as_proxy"]
          },
          "transport": {
            "$ref": "#/$defs/transport"
          },
          "host_route": {"$ref": "#/$defs/hostRoute"},
          "status": {
            "type": "string",
            "enum": ["mandatory", "optional", "experimental", "deprecated"]
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["action"],
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "frame": {
                  "type": "string",
                  "minLength": 1
                },
                "payload": {
                  "type": "object"
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "frame": {
                        "enum": [
                          "CACHE_PUT",
                          "CACHE_ACK",
                          "CACHE_INVALIDATE",
                          "CACHE_REFERENCE",
                          "CACHE_MISS"
                        ]
                      }
                    },
                    "required": ["frame"]
                  },
                  "then": {
                    "required": ["payload"],
                    "properties": {
                      "payload": {"$ref": "#/$defs/cacheIdentity"}
                    }
                  }
                },
                {
                  "if": {
                    "properties": {"frame": {"const": "CACHE_MISS"}},
                    "required": ["frame"]
                  },
                  "then": {
                    "properties": {
                      "payload": {
                        "required": ["miss_reason"],
                        "properties": {
                          "miss_reason": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "expect": {
            "type": "object",
            "required": ["terminal"],
            "properties": {
              "terminal": {
                "type": "string",
                "enum": ["success", "cancelled", "dropped", "error"]
              },
              "frames": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "route": {"$ref": "#/$defs/hostRouteExpectation"}
            },
            "additionalProperties": false
          }
        },
        "oneOf": [
          {"required": ["transport"], "not": {"required": ["host_route"]}},
          {"required": ["host_route"], "not": {"required": ["transport"]}}
        ],
        "allOf": [
          {
            "if": {"required": ["host_route"]},
            "then": {
              "properties": {"expect": {"required": ["route"]}}
            },
            "else": {
              "properties": {"expect": {"not": {"required": ["route"]}}}
            }
          }
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
